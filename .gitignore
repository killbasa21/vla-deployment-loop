# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Vendored reference repo, not part of this project.
molmoact2/

# mujoco_menagerie is a pinned SUBMODULE, not a gitignored clone. Our own scene XMLs used
# to live inside it, untracked and with no history -- which cost one silent revert of the
# arm gains. They now live in scenes/ and the submodule stays pristine upstream.

# Per-run debug artifacts (camera frames + jsonl logs) -- see CLAUDE.md.
# Bulky and regenerated every run; previously committed by accident and had
# to be purged (see "deleted major assets" commit) -- don't repeat that.
assets/

# Locally generated LeRobot datasets. The source of truth is the Modal data
# volume / reproduced collection command, not git history.
data/

# Fine-tune checkpoints are large binary artifacts. Keep run_info.md metadata
# in git, but never commit pulled checkpoint shards or partial downloads.
# NOTE: a directory-name-specific pattern here (e.g. fine_tunes/**/checkpoints/)
# is not enough -- pulled checkpoints don't always land under a "checkpoints/"
# dir (e.g. fine_tunes/pick_up_tasks/lora_train/step500-merged/model.pt), so
# ignore everything under fine_tunes/ except run_info.md.
fine_tunes/**
!fine_tunes/**/
!fine_tunes/**/run_info.md

# Generated fine-tune datasets (libero/fine_tune/a1, a2, ..., b1). Same reasoning as
# `data/` above: a few hundred MB of inline-PNG parquet per 50 episodes, reproducible
# from collect_finetune_data.py with the seed recorded in libero/fine_tune/README.md.
# The collector, the writer and the READMEs ARE tracked -- only the parquet is not.
libero/fine_tune/[a-z][0-9]*/**
!libero/fine_tune/[a-z][0-9]*/
!libero/fine_tune/[a-z][0-9]*/README.md

# Agent tooling, not part of this project.
.agents/

# Locally unpacked AWS CLI installer -- 340 MB of vendor binaries, not project code.
aws/
awscliv2.zip
