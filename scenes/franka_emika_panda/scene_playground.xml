<mujoco model="panda pick and place playground">
  <!-- A layout-editing variant of scene_pick_place.xml: every object (box + all 3 bins)
       gets a <freejoint/> so it's draggable with the mouse in the viewer. Gravity is
       left on (same as the real task scene) -- an earlier version of this file used
       gravcomp="1" to cancel gravity so objects would float wherever dropped, but
       free-jointed bodies have zero linear damping by default, so any velocity left
       over the instant you released the drag never got slowed down (nothing to fight
       it with gravity gone) -- objects would just drift off indefinitely instead of
       floating in place. With normal gravity restored, dropped objects fall and settle
       against the floor/each other like real objects, which is what you'd want anyway
       when picking good resting positions for the actual task scene. -->
  <include file="scene_base.xml"/>

  <asset>
    <material name="obj_red" rgba="0.8 0.1 0.1 1"/>
    <material name="obj_green" rgba="0.1 0.7 0.2 1"/>
    <material name="obj_blue" rgba="0.1 0.3 0.8 1"/>
    <material name="obj_yellow" rgba="0.85 0.75 0.1 1"/>
  </asset>

  <worldbody>
    <body name="red_box" pos="0.5 0 0.02">
      <freejoint/>
      <geom name="red_box_geom" type="box" size="0.02 0.02 0.02" material="obj_red" mass="0.05"/>
    </body>

    <body name="green_bin" pos="0.5 0.25 0">
      <freejoint/>
      <geom type="box" size="0.05 0.05 0.002" pos="0 0 0.002" material="obj_green"/>
      <geom type="box" size="0.002 0.05 0.02" pos="0.05 0 0.02" material="obj_green"/>
      <geom type="box" size="0.002 0.05 0.02" pos="-0.05 0 0.02" material="obj_green"/>
      <geom type="box" size="0.05 0.002 0.02" pos="0 0.05 0.02" material="obj_green"/>
      <geom type="box" size="0.05 0.002 0.02" pos="0 -0.05 0.02" material="obj_green"/>
    </body>

    <body name="blue_bin" pos="0.5 -0.25 0">
      <freejoint/>
      <geom type="box" size="0.05 0.05 0.002" pos="0 0 0.002" material="obj_blue"/>
      <geom type="box" size="0.002 0.05 0.02" pos="0.05 0 0.02" material="obj_blue"/>
      <geom type="box" size="0.002 0.05 0.02" pos="-0.05 0 0.02" material="obj_blue"/>
      <geom type="box" size="0.05 0.002 0.02" pos="0 0.05 0.02" material="obj_blue"/>
      <geom type="box" size="0.05 0.002 0.02" pos="0 -0.05 0.02" material="obj_blue"/>
    </body>

    <body name="yellow_bin" pos="0.7 0 0">
      <freejoint/>
      <geom type="box" size="0.05 0.05 0.002" pos="0 0 0.002" material="obj_yellow"/>
      <geom type="box" size="0.002 0.05 0.02" pos="0.05 0 0.02" material="obj_yellow"/>
      <geom type="box" size="0.002 0.05 0.02" pos="-0.05 0 0.02" material="obj_yellow"/>
      <geom type="box" size="0.05 0.002 0.02" pos="0 0.05 0.02" material="obj_yellow"/>
      <geom type="box" size="0.05 0.002 0.02" pos="0 -0.05 0.02" material="obj_yellow"/>
    </body>

    <body name="scene_center" pos="0.55 0 0.05"/>
    <camera name="external_cam" mode="targetbody" target="scene_center" pos="1.2 -0.9 0.9"/>
  </worldbody>
</mujoco>
