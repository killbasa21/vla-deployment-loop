<mujoco model="panda (stock Franka hand, LIBERO/robosuite-matched)">
  <!-- Panda with the STOCK FRANKA HAND, for libero/libero_closed_loop.py.

       This file is menagerie's upstream panda.xml (i.e. `git show HEAD:panda.xml`)
       VERBATIM, plus the four marked additions below. It exists because the working
       panda.xml in this tree has had its stock hand replaced by a Robotiq 2F-85 -- the
       gripper DROID actually has -- and MolmoAct2-LIBERO was pretrained on robosuite
       renders of the stock Franka hand. Every difference between the two grippers
       (finger kinematics, pad shape, pad friction, reported gripper_qpos units, and the
       eef-site convention) sat directly in the model's observation and action space.

       panda.xml is deliberately NOT edited: the DROID path (phase3_closed_loop.py,
       phase4_collect_demos.py) and the already-collected dataset both depend on the
       2F-85 being there. Same additive rule scene_libero.xml follows.

       ADDITIONS, all inside <body name="hand">, all traceable to robosuite 1.5.2:
         1. `grip_site`  -- LIBERO's `robot0_eef`, position AND frame. See its comment.
         2. `eye_in_hand` -- robosuite's own wrist camera, copied verbatim.
         3. pad friction/solref on the fingertip_pad_collision_* classes, matched to
            robosuite's finger pads.
       Nothing else in this file differs from upstream. -->
  <compiler angle="radian" meshdir="../../mujoco_menagerie/franka_emika_panda/assets" autolimits="true"/>

  <option integrator="implicitfast"/>

  <default>
    <default class="panda">
      <material specular="0.5" shininess="0.25"/>
      <joint armature="0.1" damping="1" axis="0 0 1" range="-2.8973 2.8973"/>
      <general dyntype="none" biastype="affine" ctrlrange="-2.8973 2.8973" forcerange="-87 87"/>
      <default class="finger">
        <joint axis="0 1 0" type="slide" range="0 0.04"/>
      </default>

      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom type="mesh" group="3"/>

        <!-- ADDITION 3: pad contact parameters matched to robosuite's finger pads.
             Upstream menagerie leaves these at MuJoCo defaults (friction 1 0.005 0.0001,
             solref 0.02 1). robosuite's panda_gripper.xml gives BOTH pad geoms:
                 friction="2 0.05 0.0001"  solref="0.01 0.5"
             i.e. double the sliding friction, 10x the torsional friction, and a
             deliberately SOFT, underdamped (zeta=0.5) contact -- squishy pads. Both
             matter for a sphere grasp, which has no form closure and is held by friction
             alone. PHASE5_PLAN.md Tier B attributes the "2.0" figure to DROID; it is
             actually robosuite's, which is the number that counts here.

             priority="1" is OURS, not robosuite's. With equal priorities MuJoCo mixes
             pairwise (friction elementwise max, solref the stiffer of the two), so the
             ball's own defaults would partly override the softness we just matched.
             Priority makes the pad's parameters win outright, which is what reproduces
             robosuite's behaviour rather than merely copying its numbers. -->
        <default class="fingertip_pad_collision_1">
          <geom type="box" size="0.0085 0.004 0.0085" pos="0 0.0055 0.0445"
            friction="2 0.05 0.0001" solref="0.01 0.5" priority="1"/>
        </default>
        <default class="fingertip_pad_collision_2">
          <geom type="box" size="0.003 0.002 0.003" pos="0.0055 0.002 0.05"
            friction="2 0.05 0.0001" solref="0.01 0.5" priority="1"/>
        </default>
        <default class="fingertip_pad_collision_3">
          <geom type="box" size="0.003 0.002 0.003" pos="-0.0055 0.002 0.05"
            friction="2 0.05 0.0001" solref="0.01 0.5" priority="1"/>
        </default>
        <default class="fingertip_pad_collision_4">
          <geom type="box" size="0.003 0.002 0.0035" pos="0.0055 0.002 0.0395"
            friction="2 0.05 0.0001" solref="0.01 0.5" priority="1"/>
        </default>
        <default class="fingertip_pad_collision_5">
          <geom type="box" size="0.003 0.002 0.0035" pos="-0.0055 0.002 0.0395"
            friction="2 0.05 0.0001" solref="0.01 0.5" priority="1"/>
        </default>
      </default>
    </default>
  </default>

