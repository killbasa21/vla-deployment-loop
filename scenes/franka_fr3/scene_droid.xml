<mujoco model="fr3 robotiq droid scene">
  <!-- DROID-matching scene: FR3 + Robotiq arm (fr3_robotiq.xml, this directory) mounted on a
       pedestal beside a table, DROID's put-everything-in-box task objects (approximated with
       primitives -- MuJoCo doesn't load the YCB meshes sim_eval/tasks/droid_tasks/
       droid_put_everything_in_box.py uses directly), open-top box sized with that file's exact
       numbers (box_inner_half=0.09, box_height=0.06, box_wall=0.008).

       Coordinate frame note: sim_eval's DroidPutEverythingInBoxEnv places its robot at
       robot_base_p=[-0.85, 0, -0.2] and its objects/box at x=-0.40 relative to a ManiSkill
       TableSceneBuilder-authored table whose exact mesh/origin isn't available in this repo
       (mani_skill isn't installed locally). Rather than guess at that table's dimensions, this
       scene re-derives its own table and keeps the *relative* robot-to-object geometry from
       that config: object anchor x - robot_base x = -0.40 - (-0.85) = 0.45m forward, and
       object anchor z - robot_base z = 0 - (-0.2) = 0.2m up (i.e. table surface sits 0.2m
       above wherever the robot's own base ends up). Below, the robot is mounted at world
       (0, 0, 0.2) on a pedestal (0.2m tall, matching that same 0.2m offset) beside a table
       whose top surface is at z=0.4 -- so objects placed 0.45m forward of the robot in x and
       ±0.20m in y (droid_put_everything_in_box.py's own lego/tennis-ball/box anchors) land
       exactly on that tabletop. The pedestal height and robot_base position live in
       fr3_robotiq.xml (this directory), not here, since fr3_robotiq.xml's external_cam is
       defined relative to robot_base and needs to agree with wherever robot_base actually
       sits. -->
  <include file="fr3_robotiq.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <material name="table_mat" rgba="0.55 0.4 0.28 1"/>
    <material name="pedestal_mat" rgba="0.3 0.3 0.32 1"/>
    <material name="obj_lego" rgba="0.85 0.1 0.1 1"/>
    <material name="obj_ball" rgba="0.78 0.9 0.15 1"/>
    <material name="obj_box" rgba="0.55 0.35 0.18 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Pedestal: real DROID rigs mount the arm on a low stand beside the table rather than
         on the tabletop itself -- this cylinder is a plain stand-in for that (no equivalent
         mesh vendored here), sized to hold robot_base (fr3_robotiq.xml) at its z=0.2 mount
         height. -->
    <body name="pedestal" pos="0 0 0.1">
      <geom type="cylinder" size="0.09 0.1" material="pedestal_mat"/>
    </body>

    <!-- Table: tabletop surface at z=0.4 (0.2m above robot_base, per this file's top comment).
         Centered at x=0.6 so its near edge (x=0.25) clears the pedestal and its surface
         (x in [0.25, 0.95]) comfortably contains the object anchors at x=0.45. -->
    <body name="table" pos="0.6 0 0">
      <geom name="table_top" type="box" size="0.35 0.45 0.01" pos="0 0 0.4" material="table_mat"/>
      <geom type="box" size="0.02 0.02 0.2" pos="0.31 0.41 0.2" material="table_mat"/>
      <geom type="box" size="0.02 0.02 0.2" pos="0.31 -0.41 0.2" material="table_mat"/>
      <geom type="box" size="0.02 0.02 0.2" pos="-0.31 0.41 0.2" material="table_mat"/>
      <geom type="box" size="0.02 0.02 0.2" pos="-0.31 -0.41 0.2" material="table_mat"/>
    </body>

    <!-- Objects: droid_put_everything_in_box.py's own layout -- lego duplo left (+y), tennis
         ball right (-y), open box centered between them -- at this scene's re-derived anchor
         (0.45, 0, table surface), same relative spacing (0.20m either side) as that file's
         _objects_cfg. Sized to real-object dimensions since the actual YCB meshes aren't
         available: a small duplo-brick-sized box, and a regulation tennis ball radius
         (6.7cm diameter / 2). -->
    <body name="lego_duplo" pos="0.45 0.20 0.4095">
      <freejoint/>
      <geom type="box" size="0.016 0.008 0.0095" material="obj_lego" mass="0.02"/>
    </body>

    <body name="tennis_ball" pos="0.45 -0.20 0.433">
      <freejoint/>
      <geom type="sphere" size="0.033" material="obj_ball" mass="0.058"/>
    </body>

    <!-- Open-top box, same 5-primitive construction as franka_emika_panda/scene_pick_place.xml's
         bins, but sized with droid_put_everything_in_box.py's own exact numbers:
         box_inner_half=0.09, box_height=0.06, box_wall=0.008. No joint (static/fixed to
         world), same as that file's bins. Doubles as external_cam's look-at target below,
         since it sits at the center of the workspace. -->
    <body name="open_box" pos="0.45 0 0.4">
      <geom type="box" size="0.098 0.098 0.004" pos="0 0 0.004" material="obj_box"/>
      <geom type="box" size="0.004 0.098 0.03" pos="0.094 0 0.038" material="obj_box"/>
      <geom type="box" size="0.004 0.098 0.03" pos="-0.094 0 0.038" material="obj_box"/>
      <geom type="box" size="0.098 0.004 0.03" pos="0 0.094 0.038" material="obj_box"/>
      <geom type="box" size="0.098 0.004 0.03" pos="0 -0.094 0.038" material="obj_box"/>
    </body>

    <!-- external_cam: world-mounted, not robot-relative -- see fr3_robotiq.xml's own comment
         (where this camera used to live) for why DROID's raw eye/target numbers don't
         transfer to this re-derived scene. Same diagonal-elevated approach
         franka_emika_panda/scene_pick_place.xml's external_cam already uses (render-and-check
         tuned, not analytically derived), just scaled up for this scene's taller table:
         mode="targetbody" aims at "open_box" (the workspace center) so only the eye position
         needed hand-tuning. fovy=71.5 is DROID's real spec (focal=2.1mm, sensor=3.024mm ->
         2*atan(3.024/(2*2.1))), the one part of their camera config that's a frame-independent
         physical property and does carry over. -->
    <camera name="external_cam" pos="1.3 -0.9 1.2" mode="targetbody" target="open_box" fovy="71.5"/>
  </worldbody>
</mujoco>
